require './models/user'

helpers do
  def current_user
    @current_user ||= User.find(session[:user_id]) if session[:user_id]
  end

  def logged_in?
    !!current_user
  end

  def login_required
    redirect '/auth/login' unless logged_in?
  end
end

# Signup
post '/auth/signup' do
  user = User.new(email: params[:email], password: params[:password], password_confirmation: params[:password_confirmation])
  if user.save
    session[:user_id] = user.id
    redirect '/'
  else
    status 422
    body user.errors.full_messages.join(", ")
  end
end

# Login
post '/auth/login' do
  user = User.find_by(email: params[:email])
  if user&.authenticate(params[:password])
    session[:user_id] = user.id
    redirect '/'
  else
    status 401
    "Invalid credentials"
  end
end

# Logout
get '/auth/logout' do
  session.clear
  redirect '/'
end